SELECT UPPER(emp_name)
FROM employee_payments;
SELECT emp_name,
       base_salary + IFNULL(bonus, 0) AS total_income
FROM employee_payments;
SELECT emp_name,
       ROUND(base_salary + IFNULL(bonus,0)) AS total_income
FROM employee_payments;
SELECT emp_name, YEAR(joining_date)
FROM employee_payments;
SELECT emp_name,
    base_salary,
 CASE 
  WHEN base_salary>=80000 THEN 'High'
  WHEN base_salary >= 65000 THEN 'Medium'
  ELSE 'Low'
  END AS salary_category
FROM employee_payments;
SELECT emp_name,
    joining_date,
CASE
 WHEN YEAR(CURDATE())-YEAR(joining_date)>7
  THEN 'Senior'
 ELSE 'Junior'
END AS experience_level
FROM employee_payments;
SELECT emp_name,
       CASE
           WHEN YEAR(CURDATE()) - YEAR(joining_date) > 7 THEN 'Senior'
           WHEN YEAR(CURDATE()) - YEAR(joining_date) >= 4 THEN 'Mid'
           ELSE 'Junior'
       END AS experience_level
FROM employee_payments;

SELECT  UPPER(customer_name)
FROM orders_delivery;SELECT delivery_date,
order_date,
DATEDIFF(delivery_date, order_date) AS delivery_days
FROM orders_delivery;

SELECT order_id,
       order_date,
       IFNULL(delivery_date,CURDATE())AS delivery_date
 FROM orders_delivery;
 SELECT order_id,
 TRUNCATE(order_amount,1)AS TRUNCATED_AMOUNT
 FROM orders_delivery;
 
 
